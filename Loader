-- ╔══════════════════════════════════════════════════════════════════════╗
-- ║  ZUNI HUB - LOADER v3.0                                             ║
-- ║  Detecta jogo, limpa, carrega base + módulo                         ║
-- ╚══════════════════════════════════════════════════════════════════════╝

local BASE_URL = "https://raw.githubusercontent.com/pietrocanaltu-rgb/nee/refs/heads/main/Zuni_hub_base.lua"
local ETW_URL  = "https://raw.githubusercontent.com/pietrocanaltu-rgb/nee/refs/heads/main/ETW.Lua"
local KING_URL = "https://raw.githubusercontent.com/pietrocanaltu-rgb/nee/refs/heads/main/King.Lua"

local ID_ETW  = 5677613211
local ID_KING = 4520749081

-- ═══════════════════════════════════════════════════════════════════════
-- LIMPEZA
-- ═══════════════════════════════════════════════════════════════════════
if _G.ZuniHub then
    pcall(function() _G.ZuniHub.Alive = false end)
    pcall(function() _G.ZuniHub.DisconnectAll() end)
    _G.ZuniHub = nil
end
if _G.N3onHub then
    pcall(function() _G.N3onHub.Alive = false end)
    _G.N3onHub = nil
end

local PlayerGui = game.Players.LocalPlayer:WaitForChild("PlayerGui")
for _, name in ipairs({"ZuniHub", "ZuniNotify", "N3onHub", "FlyControls"}) do
    local g = PlayerGui:FindFirstChild(name)
    if g then pcall(function() g:Destroy() end) end
end
task.wait(0.3)

-- ═══════════════════════════════════════════════════════════════════════
-- SAFE LOAD
-- ═══════════════════════════════════════════════════════════════════════
local function SafeLoad(url, label)
    print("[Loader] Baixando: " .. label)
    local ok, src = pcall(function() return game:HttpGet(url) end)
    if not ok or type(src) ~= "string" or #src < 10 then
        warn("[Loader] Falha download: " .. label)
        return false
    end
    local fn, err = loadstring(src, "Zuni_" .. label)
    if not fn then
        warn("[Loader] loadstring erro: " .. tostring(err))
        return false
    end
    local ok2, err2 = pcall(fn)
    if not ok2 then
        warn("[Loader] exec erro: " .. tostring(err2))
        return false
    end
    return true
end

-- ═══════════════════════════════════════════════════════════════════════
-- CARREGA BASE
-- ═══════════════════════════════════════════════════════════════════════
print("╔═══════════════════════════════════════════════════════╗")
print("║  ⚡ ZUNI HUB LOADER v3.0                              ║")
print("╚═══════════════════════════════════════════════════════╝")

if not SafeLoad(BASE_URL, "Base") then
    warn("[Loader] Abortando.")
    return
end

-- Aguarda Ready
local waited = 0
while not (_G.ZuniHub and _G.ZuniHub.Ready) and waited < 100 do
    task.wait(0.1)
    waited = waited + 1
end

if not (_G.ZuniHub and _G.ZuniHub.Ready) then
    warn("[Loader] Base não ficou pronta em 10s.")
    return
end

print("[Loader] Base pronta. Detectando jogo...")

-- ═══════════════════════════════════════════════════════════════════════
-- DETECTA E CARREGA MÓDULO
-- ═══════════════════════════════════════════════════════════════════════
local id = game.GameId
print("[Loader] GameId:", id)

if id == ID_ETW then
    SafeLoad(ETW_URL, "ETW")
elseif id == ID_KING then
    SafeLoad(KING_URL, "King")
else
    print("[Loader] Jogo não suportado (GameId: " .. tostring(id) .. ")")
end

print("[Loader] ✓ Concluído.")
