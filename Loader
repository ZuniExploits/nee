-- ║  Aguarda base ficar Ready antes de carregar módulo         ║
-- ╚══════════════════════════════════════════════════════════════╝

local BASE_URL = "https://raw.githubusercontent.com/pietrocanaltu-rgb/nee/refs/heads/main/Zuno_hub_base.lua"
local ETW_URL  = "https://raw.githubusercontent.com/pietrocanaltu-rgb/nee/refs/heads/main/ETW.Lua"
local KING_URL = "https://raw.githubusercontent.com/pietrocanaltu-rgb/nee/refs/heads/main/King.Lua"

local function SafeLoad(url)
    local ok, src = pcall(game.HttpGet, game, url)
    if not ok or type(src) ~= "string" or #src < 10 then
        warn("[Loader] Falha download: " .. url)
        return false
    end
    local fn, err = loadstring(src, "N3onChunk_" .. url)
    if not fn then
        warn("[Loader] loadstring erro: " .. tostring(err))
        return false
    end
    local ok2, err2 = pcall(fn)
    if not ok2 then
        warn("[Loader] exec erro: " .. tostring(err2))
        return false
    end
    return true
end

-- 1) Carrega base
if not SafeLoad(BASE_URL) then
    return
end

-- 2) Espera Ready (max 15s)
local t = 0
while not (_G.N3onHub and _G.N3onHub.Ready) and t < 150 do
    task.wait(0.1)
    t += 1
end
if not (_G.N3onHub and _G.N3onHub.Ready) then
    warn("[Loader] Base não ficou Ready em 15s.")
    return
end

-- 3) Detecta jogo (GameId = UniverseId)
local id = game.GameId
print("[Loader] GameId detectado:", id)

-- 4) Carrega módulo específico
if id == 4520749081 then
    SafeLoad(KING_URL)
elseif id == 16480898254 then
    SafeLoad(ETW_URL)
else
    print("[Loader] Jogo não suportado (GameId: " .. id .. ")")
end
